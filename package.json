{
  "name": "mioku-plugin-terraria",
  "version": "2.0.0",
  "description": "Terraria 服务器与 QQ 群消息互通插件，基于 TianSuo 协议",
  "main": "index.ts",
  "type": "module",
  "keywords": [
    "mioku"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mioku-lab/mioku-plugin-terraria.git"
  },
  "mioku": {
    "services": [
      "config"
    ],
    "accessHooks": [
      {
        "id": "/ts 状态",
        "match": "/^\\/ts\\s*状态/"
      },
      {
        "id": "/ts 开启同步",
        "match": "/^\\/ts\\s*开启同步/"
      },
      {
        "id": "/ts 关闭同步",
        "match": "/^\\/ts\\s*关闭同步/"
      },
      {
        "id": "/ts 重连",
        "match": "/^\\/ts\\s*重连/"
      }
    ],
    "help": {
      "title": "Terraria",
      "description": "Terraria 服务器与 QQ 群消息互通插件，基于 TianSuo 协议",
      "commands": [
        {
          "cmd": "/ts 状态",
          "desc": "查看所有已配置服务器的 WebSocket 连接状态",
          "role": "master"
        },
        {
          "cmd": "/ts 开启同步 <服务器名称>",
          "desc": "开启指定服务器的群聊消息同步功能",
          "usage": "/ts 开启同步 <服务器名称>",
          "role": "master"
        },
        {
          "cmd": "/ts 关闭同步 <服务器名称>",
          "desc": "关闭指定服务器的群聊消息同步功能",
          "usage": "/ts 关闭同步 <服务器名称>",
          "role": "master"
        },
        {
          "cmd": "/ts 重连",
          "desc": "断开并重新建立所有服务器的 WebSocket 连接",
          "role": "master"
        }
      ]
    }
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "mioku": "^1.0.0"
  },
  "devDependencies": {
    "mioku": "workspace:*",
    "@types/ws": "^8.5.13"
  }
}
